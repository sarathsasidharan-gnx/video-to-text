# Virtual environment (~4 GB, rebuilt by setup.bat / install_offline.bat)
.venv/

# Local scratch - may hold real recordings. Never commit.
tmp/

# Your media and your transcripts stay on your machine.
input/*
output/*
!input/.gitkeep
!output/.gitkeep

# Offline bundle contents - far too big for a repo.
# These are published as GitHub Release assets instead, see README.
wheels/
models/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
